# Copia este archivo a `.env` y ajusta lo que necesites.
# El justfile y compose.yaml leen estas variables.

# Conexión
POSTGRES_USER=sofipo
POSTGRES_PASSWORD=sofipo
POSTGRES_DB=sofipo
# Puerto en el host. 5433 evita chocar con un Postgres local en 5432.
HOST_PORT=5433

# Persistencia
# volume  -> volumen nombrado docker (default, recomendado)
# bind    -> carpeta ./data/pgdata en el repo (útil para inspeccionar en disco)
PGDATA_MODE=volume

# Generación de datos
# Factor de escala. 1 = ~2M-3M filas en las tablas grandes, < 2 GB en disco.
SCALE=1
# Tope de seguridad. `just seed` aborta si SCALE lo excede (10 GB de disco).
SCALE_MAX=3

# Semilla determinista
# Cualquier cambio aquí cambia TODOS los datos y todos los hashes esperados.
SEED=0.42
